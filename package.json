{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "sync:energy-profile": "node scripts/sync-energy-profile.mjs",
    "check:energy-profile": "node scripts/sync-energy-profile.mjs --check",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run check:energy-profile && npm run test:predictive && npm run test:energy-coach && npm run test:automation-assistant && npm run test:billing && npm run test:premium-security && npm run build && node --test tests/*.test.mjs",
    "test:predictive": "node --experimental-strip-types --test tests/predictive-energy.test.ts",
    "test:energy-coach": "tsx --test tests/energy-coach.test.ts tests/coach-guardrails.test.ts tests/pool-heat-pump-coach.test.ts",
    "test:automation-assistant": "tsx --test tests/automation-assistant.test.ts",
    "test:billing": "tsx --test tests/stripe-subscription.test.ts",
    "test:premium-security": "tsx --test tests/premium-security.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
